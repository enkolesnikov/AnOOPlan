# eslint-plugin-jsx-a11y 6.10.2 официально поддерживает ESLint ≤9, хотя под ESLint 10
# работает: flat config и правила не используют удалённых API (проверено — плагин нашёл
# и помог исправить 19 реальных a11y-нарушений). Без этой строки `npm ci` падает на
# конфликте peer-зависимостей. Убрать, когда выйдет версия плагина с поддержкой ESLint 10.
legacy-peer-deps=true

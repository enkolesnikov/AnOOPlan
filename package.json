{
  "name": "anooplan",
  "version": "2.6.2",
  "androidVersionCode": 37,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "npm run build && playwright test",
    "test:visual": "npm run build && playwright test --config playwright.visual.config.ts",
    "test:visual:update": "npm run build && playwright test --config playwright.visual.config.ts --update-snapshots",
    "knip": "knip",
    "build:apk": "bash scripts/build-apk.sh",
    "icons": "python3 scripts/make-icons.py",
    "smoke": "node scripts/smoke-dom.mjs",
    "preview": "vite preview",
    "status": "node scripts/status.mjs",
    "status:full": "node scripts/status.mjs --full",
    "coverage": "node scripts/coverage.mjs",
    "size": "node scripts/check-size.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.0"
  }
}
